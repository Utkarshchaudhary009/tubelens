# TubeLens Phase 00 — Neon Postgres (pooled runtime vs direct migrations).
#
# Neon branch-per-env story: create one Neon project with three branches —
# `dev` (local development), `preview` (Vercel Preview), `prod` (Vercel
# Production) — and wire each environment to its branch's connection strings
# in Vercel (Project Settings → Environment Variables). Never commit real
# URLs or secrets to the repo.
#
# Local-dev story: point both vars below at the Neon `dev` branch (or a
# personal branch). A PGlite/local-proxy setup is an optional, unsupported
# extra — prefer the Neon dev branch so local and preview share the same
# Postgres behavior.
#
# Vercel env wiring: set DATABASE_URL (pooled) on every environment that
# touches the DB; set DATABASE_DIRECT_URL (direct) wherever
# `bun run db:migrate` runs (preview/prod deploy pipeline or a maintainer
# machine). Migrations are forward-only by design — verify a clean apply on
# a preview/dev branch before applying to prod.

# Pooled connection string for runtime queries (Neon pooler). REQUIRED in
# any env that touches the DB; the client fails safe (typed 503) when unset.
# Format: postgresql://<user>:<password>@<pooled-host>/<db>?sslmode=require
DATABASE_URL=

# Direct (non-pooled) connection string for migrations ONLY (`db:migrate`).
# Never use this for runtime traffic.
# Format: postgresql://<user>:<password>@<direct-host>/<db>?sslmode=require
DATABASE_DIRECT_URL=

# Tunnel pointers (GET/POST/PUT /api/v1/tunnel-url, Vercel Blob
# `tunnel-url-<name>.json` — one blob per named slot: `t3` for the T3
# remote-dev pairing URL, `transcript` for the throwaway tts-test helper).
# `name` is REQUIRED (no default slot): bare GET/POST without it is a 400.
# Bearer token the workflows send as `Authorization: Bearer <token>` when
# publishing a tunnel URL. Set the same value as the TUNNEL_UPDATE_TOKEN
# GitHub Actions secret. REQUIRED for POST/PUT; GET works without it
# (returns { data: null } when the slot is empty).
# Examples (note: always $TUNNEL_UPDATE_TOKEN, never a generic $TOKEN):
#   curl "https://tubelens-neon.vercel.app/api/v1/tunnel-url?name=t3"
#   curl -X POST "https://tubelens-neon.vercel.app/api/v1/tunnel-url" \
#     -H "Authorization: Bearer $TUNNEL_UPDATE_TOKEN" \
#     -H "Content-Type: application/json" \
#     -d '{"name": "t3", "url": "https://<name>.trycloudflare.com/pair#token=<code>", "runId": "123"}'
TUNNEL_UPDATE_TOKEN=
# Read/write token for the Vercel Blob store holding the tunnel pointers.
# Auto-provided when a Blob store is connected in Vercel Project Settings →
# Storage; copy it here for local dev (`vercel env pull` writes it).
BLOB_READ_WRITE_TOKEN=

# Upstash Redis (Part B Phase 12 — distributed rate-limit engine).
# REST client (no TCP), correct for Vercel serverless. BOTH vars must be
# present/non-blank for the Redis-backed limiter to activate; unset or blank
# either one and the API keeps serving with the allow-all default (Part A
# wire contract byte-identical). Server-only — never expose to the client,
# never commit real values.
# Format: https://<database-id>.upstash.io
UPSTASH_REDIS_REST_URL=
# Bearer token for the Upstash REST API (Upstash Console → Redis → REST API).
UPSTASH_REDIS_REST_TOKEN=
